{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "./bin/fm-copilot-hook.sh session-start",
        "powershell": "& ./bin/fm-claude-hook-launch.ps1 -Script fm-copilot-hook.sh session-start; exit $LASTEXITCODE",
        "cwd": ".",
        "timeoutSec": 180
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "^(bash|powershell)$",
        "bash": "./bin/fm-copilot-hook.sh pretool-arm",
        "powershell": "& ./bin/fm-claude-hook-launch.ps1 -Script fm-copilot-hook.sh pretool-arm; exit $LASTEXITCODE",
        "cwd": ".",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "matcher": "^(bash|powershell)$",
        "bash": "./bin/fm-copilot-hook.sh pretool-cd",
        "powershell": "& ./bin/fm-claude-hook-launch.ps1 -Script fm-copilot-hook.sh pretool-cd; exit $LASTEXITCODE",
        "cwd": ".",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "matcher": ".*",
        "bash": "./bin/fm-copilot-hook.sh pretool-subagent",
        "powershell": "& ./bin/fm-claude-hook-launch.ps1 -Script fm-copilot-hook.sh pretool-subagent; exit $LASTEXITCODE",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "./bin/fm-copilot-hook.sh agent-stop",
        "powershell": "& ./bin/fm-claude-hook-launch.ps1 -Script fm-copilot-hook.sh agent-stop; exit $LASTEXITCODE",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "notification": [
      {
        "type": "command",
        "matcher": "shell_completed",
        "bash": "./bin/fm-copilot-hook.sh notification",
        "powershell": "& ./bin/fm-claude-hook-launch.ps1 -Script fm-copilot-hook.sh notification; exit $LASTEXITCODE",
        "cwd": ".",
        "timeoutSec": 30
      }
    ]
  }
}
